# ==============================================================================
# Closet24 - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables:
#   copy .env.example .env
# ==============================================================================

# Core Settings
SECRET_KEY=change-this-secret-key-before-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://127.0.0.1:8000,http://localhost:8000

# Optional PostgreSQL Database (e.g. on Render):
# DATABASE_URL=postgresql://user:password@localhost:5432/closet24_db

# SMTP Email Configuration (Gmail App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL="Closet24 <your_email@gmail.com>"
